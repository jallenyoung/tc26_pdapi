# ---------------------------------------------------------------------------
# Environment configuration for download_activity_logs_standalone.py
# Copy this file to .env (in this directory or the repo root) and fill in
# your values, or export the variables directly in your shell.
# ---------------------------------------------------------------------------

# --- Required ---

# Tableau Cloud Manager tenant ID
PDC_TENANT_ID="your-tenant-id"

# Personal Access Token credentials (create in TCM under Account > PATs)
PDC_PAT_NAME="your-pat-name"
PDC_PAT_SECRET="your-pat-secret"  # pragma: allowlist secret

# --- Optional ---

# Directory where downloaded log files are saved (default: ./activity_logs)
# PDC_OUTPUT_DIR="./activity_logs"

# Max retry attempts on 429 / transient server errors (default: 5)
# PDC_MAX_RETRIES=5

# Exponential backoff multiplier in seconds (default: 1.0)
# Retry delays with factor=1.0: 1s, 2s, 4s, 8s, 16s
# PDC_BACKOFF_FACTOR=1.0
