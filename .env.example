# ---------------------------------------------------------------------------
# Environment configuration for tc26_pdapi scripts.
# Copy this file to .env and fill in your values, or export the variables
# directly in your shell. Any values left blank will be prompted for
# interactively at runtime.
# ---------------------------------------------------------------------------

# ===========================================================================
# download_activity_logs.py — Tableau Cloud Manager credentials
# ===========================================================================

# Tableau Cloud Manager tenant ID
PDC_TENANT_ID="your-tenant-id"

# Personal Access Token credentials (create in TCM under Account > PATs)
PDC_PAT_NAME="your-pat-name"
PDC_PAT_SECRET="your-pat-secret"  # pragma: allowlist secret

# Optional: directory where downloaded log files are saved (default: ./activity_logs)
# PDC_OUTPUT_DIR="./activity_logs"

# Optional: max retry attempts on 429 / transient server errors (default: 5)
# PDC_MAX_RETRIES=5

# Optional: exponential backoff multiplier in seconds (default: 1.0)
# Retry delays with factor=1.0: 1s, 2s, 4s, 8s, 16s
# PDC_BACKOFF_FACTOR=1.0

# ===========================================================================
# publish_activity_logs.py — Tableau Cloud / Server connection
# ===========================================================================

# Tableau Cloud or Server URL (e.g. https://10ax.online.tableau.com)
TABLEAU_SERVER_URL="your-server-url"

# Site content URL — leave blank ("") for the default site
TABLEAU_SITE_ID=""

# Personal Access Token credentials (create in Tableau Cloud under Account > PATs)
TABLEAU_TOKEN_NAME="your-token-name"
TABLEAU_TOKEN_VALUE="your-token-value"  # pragma: allowlist secret

# Optional: source folder for parsed log files (default: activity_logs)
# ACTIVITY_LOGS_DIR="activity_logs"

# Optional: working folder for intermediate files (default: .tableau_output)
# OUTPUT_DIR=".tableau_output"

# Optional: name for the published data source (default: TCM Activity Logs)
# DS_NAME="TCM Activity Logs"
